REPRO_NAME=tro-utils-checks
REPRO_DOCKER_ORG=ghcr.io/transparency-certified
REPRO_IMAGE_TAG=latest

# The version of tro-utils the image installs, read from the one place it is named.
TRO_UTILS_VERSION=$(shell sed -n 's/^ARG TRO_UTILS_VERSION=//p' Dockerfile)

# The commit of tro-checks the image imports, read likewise.
TRO_CHECKS_VERSION=$(shell sed -n 's/^ARG TRO_CHECKS_VERSION=//p' Dockerfile)

DOCKER_BUILD_PROGRESS=plain

image:                  build-image   ##
start:                  start-repro   ##

##

# Add review-ledger's make reviews target if the review-ledger module has been initialized.
-include .review-ledger/host-makefile

## update-reviews:    Update REVIEWS.md without running the other reports.
update-reviews: session
	$(RUN_IN_REPRO) 'make -C ${REPRO_MNT}/.review-ledger -f report-makefile review'

## build-candidates:  Make the candidates with tro-utils from the arrangements and resources.
build-candidates: session
	$(RUN_IN_REPRO) 'bash make-candidates'

# Create a multi-architecture Docker image builder named multiarch unless one already exists.
create-image-builder:
	docker buildx inspect multiarch > /dev/null 2>&1 || \
		docker buildx create --name multiarch --driver docker-container

## publish-image:     Build the image for x86 and ARM and push it to ghcr.io.
# Tagged with the tro-utils version as well as latest, so a run can ask for the image that
# goes with a pin rather than for whichever image was published most recently.
publish-image: create-image-builder
	docker buildx build --builder multiarch \
		--platform linux/amd64,linux/arm64 \
		--annotation "index:org.opencontainers.image.source=https://github.com/transparency-certified/tro-utils-checks" \
		--tag ${REPRO_IMAGE} \
		--tag ${REPRO_DOCKER_ORG}/${REPRO_NAME}:tro-utils-${TRO_UTILS_VERSION} \
		--push \
		--progress=${DOCKER_BUILD_PROGRESS} \
		.

# Printed for the workflows, which name the image and the version in what they build and commit.
print-image:
	@echo ${REPRO_IMAGE}

print-tro-utils-version:
	@echo ${TRO_UTILS_VERSION}

print-tro-checks-version:
	@echo ${TRO_CHECKS_VERSION}
